{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModbusMaster",
  "version": "0.17.3",
  "identifier": "com.modbusmaster.dev",
  "build": {
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../master-frontend"
    },
    "frontendDist": "../../master-frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ModbusMaster - Modbus TCP Master",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://gh.daichangyu.com/https://github.com/Karl-Dai/ModbusSim/releases/latest/download/latest-master-cn0.json",
        "https://github.com/Karl-Dai/ModbusSim/releases/latest/download/latest-master.json",
        "https://gh-proxy.com/https://github.com/Karl-Dai/ModbusSim/releases/latest/download/latest-master-cn2.json",
        "https://gh.idayer.com/https://github.com/Karl-Dai/ModbusSim/releases/latest/download/latest-master-cn3.json",
        "https://ghfast.top/https://github.com/Karl-Dai/ModbusSim/releases/latest/download/latest-master-cn1.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwMDdEMkNDRUUwQjJEMjYKUldRbUxRdnV6TklIa0M4Y0t2V0V5NXRVL0tUZ29hRXVQTExZTzZqaGdHTzJhN0NoL1FvY2pkSFMK"
    }
  }
}
